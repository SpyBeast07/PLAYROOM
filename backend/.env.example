# ==============================================================================
# PLAYROOM Backend Environment Variables
# ==============================================================================

# Application port inside the process / container
PORT=8787

# Host interface to bind on (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# VPS host port mapped to the container port (used in docker-compose.yml)
HOST_PORT=18787

# Node environment (production or development)
NODE_ENV=production

# Allowed CORS origins (comma-separated, without or with trailing slashes)
# In development: http://localhost:5173
# In production: https://playroom-chi.vercel.app (and/or local preview URLs)
# Multiple origins are separated by commas.
CORS_ORIGINS=http://localhost:5173,https://playroom-chi.vercel.app
